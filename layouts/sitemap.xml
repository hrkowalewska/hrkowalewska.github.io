{{- /* Hugo's default sitemap template plus one condition. Pages the listings
       do not link to are left out, because a sitemap is an invitation and
       these pages hold nothing worth accepting it for. Setting `show_page` on
       an item puts it back here and in the listings at the same time, which is
       the reason the rule lives in a partial rather than twice. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range .Data.Pages }}
  {{- if and .Permalink (partial "showpage.html" .) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
